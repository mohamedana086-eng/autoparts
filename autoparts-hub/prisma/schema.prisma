// Prisma schema for AutoParts Hub
// Local setup: npx prisma migrate dev   then   npm run db:seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations go straight to the database rather than through the pooler.
  // A migration takes a session-level advisory lock, and pgbouncer hands the
  // server connection holding it to the next client, so the lock outlives the
  // command and the following migration waits on it until the pool recycles.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Catalog ----------

model VehicleSystem {
  id       String    @id @default(cuid())
  name     String    // e.g. "Brake System", "Cooling System"
  slug     String    @unique
  icon     String    // lucide-react icon name
  order    Int       @default(0)
  products Product[]
}

model Manufacturer {
  id       String    @id @default(cuid())
  name     String    @unique // e.g. BMW, NISSAN, BOSCH
  isOEM    Boolean   @default(false)
  products Product[]
}

model Supplier {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique // e.g. IB16, NP20
  slug         String        @unique // url for the supplier's own page
  description  String?       // shown on that page
  reliability  String        @default("standard") // official | dealer | reliable | standard
  /// Where they ship from. Free text: a supplier list is not worth an ISO
  /// country table until something actually filters or groups by it.
  country      String?
  /// Warranty they stand behind, in months. Null means not agreed.
  guaranteeMonths Int?
  /// Lead time to fall back on for a part that has none of its own. The
  /// part's own `stockDays` always wins where it is set — this fills the gap
  /// for newly added parts rather than overriding what is already there.
  defaultStockDays Int?
  /// What they invoice in. Recorded for reference only: `Product.basePrice`
  /// stays denominated in the base currency, so the pricing engine is
  /// untouched by this.
  purchaseCurrencyId String?
  purchaseCurrency   Currency? @relation(fields: [purchaseCurrencyId], references: [id])
  /// How well they actually perform, 1–5, set by an admin. Distinct from
  /// `reliability`, which describes the trading relationship: an official
  /// distributor can still be slow. Null means nobody has rated them yet,
  /// which is not the same as rating them badly — the search filter treats
  /// unrated suppliers as excluded rather than as zero.
  rating       Int?
  /// Whether they take stock back. Its own column rather than a third value
  /// of `reliability`, because it is not an alternative to being an official
  /// distributor — a supplier can be both, or neither. Null means the terms
  /// have not been established, which is not the same as knowing they refuse:
  /// the filter only ever matches an explicit yes.
  acceptsReturns Boolean?
  products     Product[]
  markupRules  MarkupRule[]
}

model Product {
  id             String        @id @default(cuid())
  partNumber     String        @unique
  name           String
  description    String?
  manufacturerId String
  manufacturer   Manufacturer  @relation(fields: [manufacturerId], references: [id])
  vehicleSystemId String
  vehicleSystem  VehicleSystem @relation(fields: [vehicleSystemId], references: [id])
  /// Who this part is bought from. Optional so a part can be listed before
  /// sourcing is settled; the pricing engine falls back to the category
  /// default when it is unset rather than to an arbitrary supplier.
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  basePrice      Float         // supplier purchase price, before markup
  currency       String        @default("EUR")
  stockDays      Int           @default(1) // delivery lead time in days
  /// TecDoc's own article id, set only on imported parts. Lets a re-import
  /// recognise what it created last time. Null on the hand-seeded catalogue.
  tecDocId       Int?          @unique
  interchanges   Interchange[] @relation("SourcePart")
  fitments       Fitment[]
  orderItems     OrderItem[]
  images         ProductImage[]
  stock          StockLevel[]
  cartItems      CartItem[]
  createdAt      DateTime      @default(now())
}

/// A picture of a part.
///
/// Order alone decides which one leads — the first is the primary. A separate
/// `isPrimary` flag would be a second column saying the same thing, and the
/// two could disagree; the supplier table already avoids that shape.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// Alternative text. Null falls back to the part's name where it is shown.
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// cross-reference: which part numbers are interchangeable with which
model Interchange {
  id             String   @id @default(cuid())
  sourceId       String
  source         Product  @relation("SourcePart", fields: [sourceId], references: [id])
  targetPartNo   String
  targetManufacturer String
  /// Whether the two parts are equivalent outright, as opposed to a close
  /// or partial substitute. Says nothing about who made it — an aftermarket
  /// brand's part is routinely an exact equivalent.
  exactMatch     Boolean  @default(false)
  /// Whether this is the vehicle maker's own number, as opposed to another
  /// brand's. A separate question from `exactMatch`, and the one customers
  /// searching a number off a dealer invoice are actually asking.
  isOEM          Boolean  @default(false)
}

// ---------- Vehicles & fitment ----------
// Make -> model -> engine variant -> fitment, the same shape TecDoc uses.
// A part is only offered for a vehicle when a Fitment row says so.

model VehicleMake {
  id       String         @id @default(cuid())
  name     String         @unique // BMW, VOLKSWAGEN
  /// World Manufacturer Identifier prefixes: the first three characters of a
  /// VIN. Used to name the make when a customer pastes a chassis number.
  wmiCodes String[]
  models   VehicleModel[]
  /// TecDoc manufacturer id — see Product.tecDocId.
  tecDocId Int?           @unique
}

model VehicleModel {
  id       String           @id @default(cuid())
  makeId   String
  make     VehicleMake      @relation(fields: [makeId], references: [id])
  name     String           // "3 Series (E90)"
  yearFrom Int
  yearTo   Int?             // null = still built
  variants VehicleVariant[]
  /// TecDoc model-series id — see Product.tecDocId.
  tecDocId Int?             @unique

  @@unique([makeId, name])
}

/// One engine/body version of a model — the level parts actually fit.
model VehicleVariant {
  id         String       @id @default(cuid())
  modelId    String
  model      VehicleModel @relation(fields: [modelId], references: [id])
  name       String       // "320d 2.0"
  engineCode String?
  powerKw    Int?
  fuel       String       @default("diesel") // diesel | petrol | hybrid | electric
  yearFrom   Int
  yearTo     Int?
  fitments   Fitment[]
  /// TecDoc vehicle id — the id a fitment link refers to. See Product.tecDocId.
  tecDocId   Int?         @unique

  @@unique([modelId, name])
}

model Fitment {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   VehicleVariant @relation(fields: [variantId], references: [id])
  note      String?        // "front axle only"

  @@unique([productId, variantId])
  @@index([variantId])
}

// ---------- Clients & pricing tiers ----------

model ClientCategory {
  id                 String   @id @default(cuid())
  name               String   // e.g. "Retail", "Price 1" ... "Price 10"
  markupPercent      Float    // default markup applied on top of basePrice
  minOrderAmount     Float    @default(0)
  requiresApproval   Boolean  @default(false)
  shelfLifeDays      Int      @default(1) // how long a cart price is held
  clients            Client[]
  markupRules        MarkupRule[]
}

// ---------- Currency ----------

/// A currency prices can be shown in.
///
/// Exactly one row is the base: the currency the catalogue's purchase prices
/// are actually kept in, whose rate is 1. Every other rate says how many of
/// that currency one unit of the base buys, so converting is a multiplication
/// and there is only ever one direction to get wrong.
model Currency {
  id       String   @id @default(cuid())
  code     String   @unique // ISO 4217: EUR, USD, EGP
  name     String
  symbol   String
  /// Units of this currency per one unit of the base. 1 on the base row.
  rate     Float    @default(1)
  /// The currency `Product.basePrice` is denominated in. Exactly one row.
  isBase   Boolean  @default(false)
  active   Boolean  @default(true)
  clients  Client[]
  /// Suppliers who invoice in it. Reference only — see Supplier.purchaseCurrencyId.
  suppliers Supplier[]
}

// ---------- Auth ----------

// Roles are stored as strings rather than a Prisma enum. The app narrows
// them in code (toRole() in lib/auth.ts), which keeps the schema portable
// across connectors. Allowed values:
//   ADMIN   full access to /admin
//   SALES   staff account: reaches only its own clients and their orders
//   B2B     trade/wholesale account, tied to a negotiated ClientCategory
//   RETAIL  ordinary retail customer

model Client {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  passwordHash     String?         // null = account created by admin without login access yet
  role             String          @default("RETAIL")
  city             String?
  categoryId       String?
  category         ClientCategory? @relation(fields: [categoryId], references: [id])
  orders           Order[]
  createdAt        DateTime        @default(now())

  /// Taken off the price the markup engine resolves, after it has run — see
  /// the order of operations in lib/pricing.ts. Negotiated per account, on
  /// top of whatever tier they are on.
  discountPercent  Float           @default(0)

  /// What this account is quoted in. Null means the base currency.
  currencyId       String?
  currency         Currency?       @relation(fields: [currencyId], references: [id])

  /// The SALES account that looks after this customer. A self-relation
  /// because staff and customers are both rows in this table, told apart by
  /// `role` — the same way ADMIN already is.
  salesManagerId   String?
  salesManager     Client?         @relation("SalesManaged", fields: [salesManagerId], references: [id])
  managedClients   Client[]        @relation("SalesManaged")

  cart             Cart?
  notifications    Notification[]
}

// ---------- Inventory ----------

/// A place stock is held.
///
/// Not the same thing as a supplier: a supplier is who a part is bought from,
/// a warehouse is where the ones already bought sit. A part can come from one
/// supplier and be spread across several warehouses.
model Warehouse {
  id        String         @id @default(cuid())
  code      String         @unique // EU1, EG1
  name      String
  city      String?
  address   String?
  /// Whether it can be picked from. Closing one deactivates it rather than
  /// deleting it, so its stock rows and the outlets it serves survive.
  active    Boolean        @default(true)
  /// Which warehouse to draw from first when nothing says which. Higher wins.
  priority  Int            @default(0)
  stock     StockLevel[]
  outlets   RetailOutlet[]
  createdAt DateTime       @default(now())
}

/// How many of one part sit in one warehouse.
///
/// A row per (part, warehouse) rather than a quantity column on Product. The
/// catalogue has never carried a quantity at all, and putting one on the part
/// would force a single total no individual warehouse could be held to.
model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  /// Committed to orders that have not shipped. What is sellable is
  /// `quantity - reserved`, so counting the shelf and promising stock stay two
  /// separate facts and neither has to be reconstructed from the other.
  reserved    Int       @default(0)
  /// Where on the shelf. Free text — aisle and bay schemes differ per site,
  /// and nothing queries it.
  binLocation String?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

/// A counter a customer can walk into or collect an order from.
model RetailOutlet {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  city        String?
  address     String?
  phone       String?
  /// The warehouse that supplies it. Null while that is not settled — an
  /// outlet gets opened before its logistics are agreed.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@index([warehouseId])
}

// ---------- Basket ----------

/// A customer's saved basket.
///
/// The Angular cart lives in localStorage and still does; this is the copy on
/// the server, so a basket survives a new device and staff can see what is
/// sitting unordered. It deliberately stores no prices: what a line costs is
/// resolved at checkout from the catalogue and the caller's tier, which is
/// what stops a stale or tampered basket deciding what it pays.
model Cart {
  id        String     @id @default(cuid())
  clientId  String     @unique
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  @@unique([cartId, productId])
  @@index([productId])
}

// ---------- Notifications ----------

/// Something one account should be told about.
///
/// Addressed to a Client, which is how staff are stored too — so one table
/// serves "your order shipped" to a customer and "a part ran out" to an
/// admin, without inventing a second kind of recipient.
model Notification {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// order | stock | account | system. A string for the same reason Role is —
  /// the connector stays portable and the app narrows it.
  type      String    @default("system")
  title     String
  body      String?
  /// Where clicking it goes, e.g. /orders. Null when there is nowhere to go.
  link      String?
  /// When it was read. A timestamp rather than a boolean: "unread" is the
  /// null case either way, and this keeps when they saw it, which a flag
  /// throws away.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, readAt])
}

// ---------- Complex markup engine ----------
// Mirrors the "Complex markup" rule builder: a rule matches on any
// combination of filters (all optional / "any"), and the most specific
// matching rule wins. See lib/pricing.ts for the resolution order.

// Also a string rather than an enum, for the same reason — and because
// lib/pricing.ts already models it as a string union. Allowed values:
//   PERCENT  +X %
//   AMOUNT   +X currency units
//   FIXED    set price to X

model MarkupRule {
  id               String          @id @default(cuid())
  label            String
  priority         Int             @default(0) // higher wins on ties

  // filters — null/empty = "any"
  clientCategoryId String?
  clientCategory   ClientCategory? @relation(fields: [clientCategoryId], references: [id])
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  manufacturerName String?
  vehicleSystemSlug String?
  partNumberPrefix String?
  purchasePriceFrom Float?
  purchasePriceTo   Float?

  type             String          @default("PERCENT")
  value            Float

  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
}

// ---------- Orders ----------

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  status       String      @default("order_is_sent") // order_is_sent | processing | shipped | paid
  items        OrderItem[]
  createdAt    DateTime    @default(now())

  /// What the customer was quoted in, and the rate at the time. Recorded on
  /// the order rather than read back off the account: changing a customer's
  /// currency later must not rewrite what their past orders said.
  currencyCode String      @default("EUR")
  currencyRate Float       @default(1)
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int      @default(1)
  unitPrice    Float    // resolved price at time of order (after markup)
}
