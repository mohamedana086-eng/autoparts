# Copy to .env and fill in.

# Postgres connection string. Any hosted provider works (Neon, Vercel
# Postgres, Supabase, Railway). On serverless platforms use the provider's
# POOLED connection string — each function instance opens its own client.
#   Local docker:  postgresql://postgres:postgres@localhost:5432/autoparts
DATABASE_URL="postgresql://user:password@host:5432/autoparts?sslmode=require"

# Signs the session cookie. Generate a long random value for any
# non-local environment: `openssl rand -hex 32`
# Changing this invalidates every existing session.
AUTH_SECRET="dev-only-insecure-secret-change-me"
