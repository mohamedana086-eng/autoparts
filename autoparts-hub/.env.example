# Copy to .env and fill in.

# Postgres connection string. Any hosted provider works (Neon, Vercel
# Postgres, Supabase, Railway). On serverless platforms use the provider's
# POOLED connection string — each function instance opens its own client.
#   Local docker:  postgresql://postgres:postgres@localhost:5432/autoparts
DATABASE_URL="postgresql://user:password@host:5432/autoparts?sslmode=require"

# Signs the session cookie. Generate a long random value for any
# non-local environment: `openssl rand -hex 32`
# Changing this invalidates every existing session.
AUTH_SECRET="dev-only-insecure-secret-change-me"

# --- TecDoc catalogue import (optional) ---
# Only `npm run db:import:tecdoc` reads these; the app itself never calls
# TecAlliance. Both come from your TecAlliance subscription. Leave them unset
# and run the import with --fixture to work offline.
#TECDOC_API_KEY=""
#TECDOC_PROVIDER_ID=""

# The catalogue is filtered by market, so the wrong country quietly returns a
# smaller catalogue rather than an error. Defaults: en / DE.
#TECDOC_LANG="en"
#TECDOC_COUNTRY="DE"

# Override only if TecAlliance moves you to a different endpoint version.
#TECDOC_ENDPOINT="https://webservice.tecalliance.services/pegasus-3-0/services/TecdocToCatDLB.jsonEndpoint"
